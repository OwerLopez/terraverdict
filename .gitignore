# Entornos y dependencias
.venv/
venv/
node_modules/

# Artefactos de construcción
dist/
build/
*.egg-info/
*.tsbuildinfo

# Cachés de herramientas
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.vite/

# Bases de datos locales (se reconstruyen con `python -m app.cli importar`)
*.db
*.db-wal
*.db-shm
*.sqlite3

# Secretos y configuración local (usar .env.example como plantilla)
.env
.env.*
!.env.example

# Descargas crudas: se regeneran con `tv ingest-fenomenos`. Se versionan solo los manifiestos
# (SHA-256, URL y fecha de cada archivo) y el registro de descarga, para auditar la procedencia.
data/raw/*/*
!data/raw/*/manifiesto.json
data/interim/*
data/processed/*
!data/*/.gitkeep

# Sistema operativo y editores
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
