# Plantilla de variables (copiar a .env.compose para docker compose, o exportar en el entorno).
# Nunca versionar archivos con valores reales: .env y .env.* están en .gitignore.

# --- API (backend/app/core/config.py) ---
TV_ENTORNO=desarrollo                  # desarrollo | pruebas | produccion
TV_DATABASE_URL=sqlite:////datos/terraverdict.db
# Con el perfil postgres de docker compose:
# TV_DATABASE_URL=postgresql+psycopg://terraverdict:cambiar-esta-clave@postgres:5432/terraverdict
TV_JWT_SECRETO=                        # >= 32 caracteres en producción
TV_CORS_ORIGENES=["http://localhost:8080"]
TV_ANTHROPIC_API_KEY=                  # opcional: habilita el asistente
POSTGRES_USER=terraverdict
POSTGRES_PASSWORD=cambiar-esta-clave

# --- Pipeline científico ---
EARTHDATA_TOKEN=                       # token de urs.earthdata.nasa.gov (IMERG); la cuenta debe aceptar la EULA de GES DISC
TV_CLAVE_INGESTA=                      # clave de servicio con alcance 'ingesta' para `tv publicar`
